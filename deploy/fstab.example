# Linux host examples. Choose NFS OR SMB for each mount, never both for one path.
# Replace server/export names. Create mountpoint directories on the host once.
# noauto + automount avoids blocking general host boot; systemd RequiresMountsFor
# explicitly brings the mounts up before signage. Credentials stay on the host.

# NFS (keep hard semantics; do not switch to soft to hide NAS failures)
nas.example.org:/volume1/signage /mnt/signage-media nfs4 rw,hard,_netdev,noauto,nofail,x-systemd.automount,x-systemd.mount-timeout=30s,noexec,nosuid,nodev 0 0
nas.example.org:/volume1/office-content /mnt/signage-library nfs4 rw,hard,_netdev,noauto,nofail,x-systemd.automount,x-systemd.mount-timeout=30s,noexec,nosuid,nodev 0 0

# SMB alternatives; /etc/signage/nas.credentials must be root-owned, mode 0600.
# //nas.example.org/signage /mnt/signage-media cifs credentials=/etc/signage/nas.credentials,vers=3.1.1,uid=1000,gid=1000,file_mode=0640,dir_mode=0750,_netdev,noauto,nofail,x-systemd.automount,x-systemd.mount-timeout=30s,noexec,nosuid,nodev 0 0
# //nas.example.org/office-content /mnt/signage-library cifs credentials=/etc/signage/nas.credentials,vers=3.1.1,uid=1000,gid=1000,file_mode=0640,dir_mode=0750,_netdev,noauto,nofail,x-systemd.automount,x-systemd.mount-timeout=30s,noexec,nosuid,nodev 0 0
