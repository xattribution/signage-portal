# OPTIONAL. The quick start (`docker compose up -d`) needs no .env at all; first-launch setup
# and the Settings page cover the basics. Use this file for production hardening, NAS
# storage (docker-compose.host-storage.yml) and Cloudflare. Anything set here overrides
# and locks the matching field on the Settings page. Read docs/INSTALL.md first.

# Published port and interface. Use 127.0.0.1 when a reverse proxy on this host fronts it.
SIGNAGE_PORT=51480
SIGNAGE_BIND=127.0.0.1

# Host paths, used only with docker-compose.host-storage.yml.
MEDIA_ROOT=/mnt/signage-media
DATA_ROOT=/var/lib/signage/data
SPOOL_ROOT=/var/lib/signage/spool

SITE_NAME=Signage
# Include localhost/127.0.0.1 for container health checks.
ALLOWED_HOSTS=localhost,127.0.0.1,signage.example.org,play.signage.example.org
ADMIN_ORIGINS=https://signage.example.org
# Optional LAN origin for the player URLs copied by the admin UI (no path).
# It must be reachable by displays and its hostname must also be in ALLOWED_HOSTS.
PLAYER_BASE_URL=https://play.signage.example.org
PLAYER_ONLY_HOSTS=play.signage.example.org
# Actual peer addresses of trusted reverse proxies ONLY. Never *.
FORWARDED_ALLOW_IPS=127.0.0.1

AUTH_MODE=local
# Optional. Leave ADMIN_PASSWORD blank to create the first account on the setup page instead.
# If set, it creates that account at first boot; clear it afterwards.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional code the first-launch setup page asks for (8–128 characters).
SETUP_TOKEN=
# Generated locally when blank; used to salt rate-limit identifiers.
SECRET_KEY=
SESSION_HOURS=12
# auto (default) = Secure cookies on HTTPS, still usable on a plain-HTTP LAN.
# true = administration only over HTTPS (recommended behind a TLS proxy).
COOKIE_SECURE=true
# This flag is for isolated development only, never a shortcut around TLS.
ALLOW_INSECURE_DEV=false
CF_TEAM_DOMAIN=
CF_AUD=
CF_ALLOWED_EMAILS=

TARGET_WIDTH=1920
TARGET_HEIGHT=1080
VIDEO_CRF=21
MAX_UPLOAD_MB=2048
MAX_INGEST_MB=8192
MAX_CONCURRENT_UPLOADS=2
BODY_IDLE_SECONDS=60
CONVERT_MEM_MB=3072
CONVERT_CPU_SECONDS=3600
CONVERT_WALL_SECONDS=3600
DEFAULT_SLIDE_SECONDS=10
CLOCK_24H=true
PLAYER_POLL_SECONDS=5
PLAYER_FADE_MS=250
DISPLAY_ONLINE_SECONDS=30

# Strict NAS identity checks in BOTH web and converter. Create markers once on
# VERIFIED mounted shares; see docs/PERSISTENCE.md. Never create them at startup.
REQUIRE_MEDIA_MARKERS=true
MEDIA_VOLUME_ID=replace-with-your-own-media-volume-id
# Optional NAS browser overlay: docker-compose.nas.yml
SHARES_CONFIG=
SHARES_CONFIG_HOST=/etc/signage/shares.json
SHARE_INCOMING_ROOT=/mnt/signage-library/incoming
SHARE_OUTGOING_ROOT=/mnt/signage-library/outgoing
TRANSFERS_ENABLED=true
# Exact origins only; blank disables external sources. No wildcards or paths.
SOURCE_MEDIA_ORIGINS=
SOURCE_FRAME_ORIGINS=
